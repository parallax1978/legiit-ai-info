# Copy to .env.local. Never commit real values.

# Public site URL (canonical links, Open Graph, the crawler's User-Agent)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). New projects issue sb_publishable_ / sb_secret_ keys;
# older projects issue anon / service_role JWTs. Either pair works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Development only, ignored in production: route crawler requests through an HTTP proxy
# (for sandboxes that need one). The proxy resolves names, so the private-address check
# at connect time does not run through it.
# CRAWLER_PROXY_URL=http://127.0.0.1:8080

# Comma-separated admin emails. Admin pages and the cost dashboard are gated to these.
ADMIN_EMAILS=you@example.com

# Show the Google sign-in button once the Google provider is configured in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH=0

# Billing (slice 5)
PLAN_PRICE_USD=19
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
